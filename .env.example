# Copy to .env and fill in. `npm run start` and `npm run dev:server` read it.

# --- Server -------------------------------------------------------------------
PORT=8787
# The origin people open in the browser. In development that's the Vite dev server.
PUBLIC_BASE_URL=http://localhost:5173
# NODE_ENV=production serves the built front end from ./dist as well.
# NODE_ENV=production

# --- TBC Open Banking (NextGenPSD2 AIS) ----------------------------------------
# mock (default): a built-in imitation of TBC's API, no credentials needed.
# sandbox: TBC test environment. production: live (needs an NBG open banking licence).
TBC_MODE=mock
# Issued when you register your app at https://developers.tbcbank.ge (sandbox/production only).
TBC_CLIENT_ID=
# Defaults to $PUBLIC_BASE_URL/api/bank/callback. Must match what you registered with TBC.
# TBC_REDIRECT_URI=
# QWAC certificate for mutual TLS (PEM). Required for sandbox and production.
TBC_CERT_PATH=
TBC_KEY_PATH=
TBC_KEY_PASSPHRASE=
# Extra CA bundle (PEM) if TBC's chain isn't trusted by Node.
TBC_CA_PATH=
# QSealC key + certificate (PEM) for Digest and X-JWS-Signature request signing, if TBC asks for it.
TBC_SIGNING_KEY_PATH=
TBC_SIGNING_CERT_PATH=
# How many days of transactions to read, and how long a consent should last.
TBC_HISTORY_DAYS=120
TBC_CONSENT_DAYS=90

# --- AI coach (Claude) --------------------------------------------------------
# Without a key the coach falls back to Luka's built-in scripted answers.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
